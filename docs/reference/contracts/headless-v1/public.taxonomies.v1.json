{
  "contract": "public.taxonomies.v1",
  "kind": "schema",
  "summary": "Lister les taxonomies ou lire les termes d’une taxonomie publique.",
  "description": "Contrat documentaire conservé pour les deux endpoints taxonomiques v1. Le runtime retourne public.taxonomies.index.v1 pour la liste et public.taxonomies.show.v1 pour le détail.",
  "methods": [
    {
      "method": "GET",
      "path": "/api/v1/taxonomies",
      "runtime_contract": "public.taxonomies.index.v1"
    },
    {
      "method": "GET",
      "path": "/api/v1/taxonomies/{taxonomy}",
      "runtime_contract": "public.taxonomies.show.v1"
    }
  ],
  "source": "taxonomies + taxonomy_terms localized for active public site",
  "security": "Public read endpoint; may be protected by bearer scope taxonomies:read; active taxonomies and active terms only.",
  "query_params": {
    "site": {
      "type": "string",
      "required": false,
      "description": "Site key actif à cibler explicitement. Si absent, résolution par domaine/base path."
    },
    "site_id": {
      "type": "integer",
      "required": false,
      "minimum": 1,
      "description": "Identifiant technique d'un site actif. Prioritaire sur site si fourni."
    },
    "lang": {
      "type": "string",
      "required": false,
      "pattern": "^[a-z]{2}(?:-[a-z0-9]{2,8})?$",
      "description": "Code langue demandé. Si la langue n'est pas active, fallback sur la langue par défaut du site."
    }
  },
  "path_params": {
    "taxonomy": {
      "type": "string",
      "required": false,
      "description": "Clé de taxonomie active. Présente uniquement sur /api/v1/taxonomies/{taxonomy}."
    }
  },
  "response": {
    "oneOf": [
      {
        "status": 200,
        "contract": "public.taxonomies.index.v1",
        "schema": {
          "type": "object",
          "required": [
            "data",
            "meta"
          ],
          "properties": {
            "data": {
              "type": "object",
              "required": [
                "items"
              ],
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "key",
                      "name",
                      "archive_enabled",
                      "is_active"
                    ],
                    "properties": {
                      "key": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "archive_enabled": {
                        "type": "boolean"
                      },
                      "is_active": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            },
            "meta": {
              "type": "object",
              "required": [
                "contract",
                "request_id"
              ],
              "properties": {
                "contract": {
                  "type": "string"
                },
                "request_id": {
                  "type": "string"
                },
                "site_id": {
                  "type": "integer"
                },
                "language_code": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        }
      },
      {
        "status": 200,
        "contract": "public.taxonomies.show.v1",
        "schema": {
          "type": "object",
          "required": [
            "data",
            "meta"
          ],
          "properties": {
            "data": {
              "type": "object",
              "required": [
                "taxonomy",
                "terms"
              ],
              "properties": {
                "taxonomy": {
                  "type": "object",
                  "required": [
                    "key",
                    "name",
                    "archive_enabled"
                  ],
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "archive_enabled": {
                      "type": "boolean"
                    }
                  }
                },
                "terms": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "key",
                      "slug",
                      "name",
                      "description",
                      "path"
                    ],
                    "properties": {
                      "id": {
                        "type": "integer"
                      },
                      "key": {
                        "type": "string"
                      },
                      "slug": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "meta": {
              "type": "object",
              "required": [
                "contract",
                "request_id"
              ],
              "properties": {
                "contract": {
                  "type": "string"
                },
                "request_id": {
                  "type": "string"
                },
                "site_id": {
                  "type": "integer"
                },
                "language_code": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        }
      }
    ]
  },
  "errors": [
    {
      "code": "TAXONOMY_NOT_FOUND",
      "status": 404,
      "description": "Taxonomie absente ou inactive.",
      "schema": {
        "$ref": "../admin-api-v1/error.v1.json"
      }
    },
    {
      "code": "VALIDATION_FAILED",
      "status": 422,
      "description": "Contexte site/langue ou clé de taxonomie invalide.",
      "schema": {
        "$ref": "../admin-api-v1/error.v1.json"
      }
    }
  ],
  "examples": {
    "index_request": "GET /api/v1/taxonomies?lang=fr",
    "index_response": {
      "data": {
        "items": [
          {
            "key": "category",
            "name": "Catégories",
            "archive_enabled": true,
            "is_active": true
          }
        ]
      },
      "meta": {
        "contract": "public.taxonomies.index.v1",
        "request_id": "20260604120000-abc",
        "site_id": 1,
        "language_code": "fr"
      }
    },
    "show_request": "GET /api/v1/taxonomies/category?lang=fr",
    "show_response": {
      "data": {
        "taxonomy": {
          "key": "category",
          "name": "Catégories",
          "archive_enabled": true
        },
        "terms": [
          {
            "id": 3,
            "key": "news",
            "slug": "actualites",
            "name": "Actualités",
            "description": "",
            "path": "/categories/actualites"
          }
        ]
      },
      "meta": {
        "contract": "public.taxonomies.show.v1",
        "request_id": "20260604120000-abc",
        "site_id": 1,
        "language_code": "fr",
        "taxonomy_key": "category"
      }
    }
  }
}
