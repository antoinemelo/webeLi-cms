{
  "contract": "public.content.index.v1",
  "kind": "schema",
  "summary": "Lister des contenus publiés.",
  "description": "Retourne une liste légère et paginée de contenus publiés, filtrable par type, taxonomie et terme. La variante query `?type=` et la variante path `{type}` conservent le même contrat.",
  "method": "GET",
  "source": "public_content_snapshots + content_entry_publications",
  "security": "Public read endpoint; may be protected by bearer scope content:read; published snapshots and canonical active routes only; no draft/working revision exposure.",
  "paths": [
    "/api/v1/content",
    "/api/v1/content/{type}"
  ],
  "query_params": {
    "site": {
      "type": "string",
      "required": false,
      "description": "Site key actif à cibler explicitement. Si absent, résolution par domaine/base path."
    },
    "site_id": {
      "type": "integer",
      "required": false,
      "minimum": 1,
      "description": "Identifiant technique d'un site actif. Prioritaire sur site si fourni."
    },
    "lang": {
      "type": "string",
      "required": false,
      "pattern": "^[a-z]{2}(?:-[a-z0-9]{2,8})?$",
      "description": "Code langue demandé. Si la langue n'est pas active, fallback sur la langue par défaut du site."
    },
    "limit": {
      "type": "integer",
      "required": false,
      "minimum": 1,
      "maximum": 100,
      "default": 24,
      "description": "Nombre maximum d'éléments retournés."
    },
    "offset": {
      "type": "integer",
      "required": false,
      "minimum": 0,
      "default": 0,
      "description": "Décalage zéro-indexé."
    },
    "page": {
      "type": "integer",
      "required": false,
      "minimum": 1,
      "description": "Alternative à offset. Si présent, offset=(page-1)*limit."
    },
    "type": {
      "type": "string",
      "required": false,
      "description": "Type de contenu demandé lorsque la route /api/v1/content est utilisée."
    },
    "taxonomy": {
      "type": "string",
      "required": false
    },
    "term": {
      "type": "string",
      "required": false
    }
  },
  "path_params": {
    "type": {
      "type": "string",
      "required": false,
      "description": "Type de contenu actif. Présent seulement sur /api/v1/content/{type}."
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "object",
          "required": [
            "items",
            "pagination"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "key",
                  "type",
                  "title",
                  "summary",
                  "path",
                  "url",
                  "published_at",
                  "updated_at",
                  "seo",
                  "taxonomies"
                ],
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "key": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "published_at": {
                    "type": "string"
                  },
                  "updated_at": {
                    "type": "string"
                  },
                  "seo": {
                    "type": "object",
                    "required": [
                      "title",
                      "description"
                    ],
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      }
                    }
                  },
                  "taxonomies": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            },
            "pagination": {
              "type": "object",
              "required": [
                "total",
                "limit",
                "offset",
                "has_more"
              ],
              "properties": {
                "total": {
                  "type": "integer"
                },
                "limit": {
                  "type": "integer"
                },
                "offset": {
                  "type": "integer"
                },
                "has_more": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "meta": {
          "type": "object",
          "required": [
            "contract",
            "request_id"
          ],
          "properties": {
            "contract": {
              "type": "string"
            },
            "request_id": {
              "type": "string"
            },
            "site_id": {
              "type": "integer"
            },
            "language_code": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      }
    },
    "contract": "public.content.index.v1"
  },
  "errors": [
    {
      "code": "CONTENT_TYPE_NOT_FOUND",
      "status": 404,
      "description": "Le type de contenu demandé n’existe pas ou n’est pas actif.",
      "schema": {
        "$ref": "../admin-api-v1/error.v1.json"
      }
    },
    {
      "code": "VALIDATION_FAILED",
      "status": 422,
      "description": "Paramètre de contexte ou de pagination invalide.",
      "schema": {
        "$ref": "../admin-api-v1/error.v1.json"
      }
    }
  ],
  "examples": {
    "request": "GET /api/v1/content/article?lang=fr&limit=10",
    "response": {
      "data": {
        "items": [
          {
            "id": 42,
            "key": "mon-article",
            "type": "article",
            "title": "Mon article",
            "summary": "Résumé SEO",
            "path": "/articles/mon-article",
            "url": "/articles/mon-article",
            "published_at": "2026-05-01 10:00:00",
            "updated_at": "2026-05-02 10:00:00",
            "seo": {
              "title": "Mon article",
              "description": "Résumé SEO"
            },
            "taxonomies": []
          }
        ],
        "pagination": {
          "total": 1,
          "limit": 10,
          "offset": 0,
          "has_more": false
        }
      },
      "meta": {
        "contract": "public.content.index.v1",
        "request_id": "20260604120000-abc",
        "site_id": 1,
        "language_code": "fr",
        "type": "article",
        "source": "public_content_snapshots"
      }
    }
  }
}
