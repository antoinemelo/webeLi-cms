{
  "contract": "pos.catalog.bootstrap.v1",
  "kind": "schema",
  "summary": "Initialiser le catalogue POS.",
  "description": "Retourne un bootstrap compact du catalogue POS : marques, catégories, produits actifs POS et variantes actives. Les prix d'achat, marges, notes internes, fournisseurs et stocks exacts ne sont jamais exposés.",
  "method": "GET",
  "path": "/api/v1/pos/catalog/bootstrap",
  "source": "business_products + business_product_variants + business_product_base_prices + business_catalog_discounts",
  "security": "Protected by bearer scope pos.catalog.read. The headless:read alias does not grant this POS scope.",
  "query_params": {
    "lang": {"type": "string", "required": false},
    "updated_since": {"type": "string", "required": false},
    "limit": {"type": "integer", "required": false, "minimum": 1, "maximum": 1000, "default": 100},
    "offset": {"type": "integer", "required": false, "minimum": 0, "default": 0}
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "object",
          "required": ["brands", "categories", "products", "pagination", "sync"],
          "properties": {
            "brands": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
            "categories": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
            "products": {"type": "array", "items": {"type": "object", "required": ["product_id", "name", "variants"], "additionalProperties": true}},
            "pagination": {"$ref": "#/components/schemas/Pagination"},
            "sync": {"type": "object", "additionalProperties": true}
          }
        },
        "meta": {"$ref": "#/components/schemas/PublicMeta"}
      }
    }
  },
  "errors": [{"status": 401, "code": "AUTH_REQUIRED"}, {"status": 403, "code": "AUTHZ_FORBIDDEN"}],
  "examples": {
    "response": {
      "data": {
        "brands": [{"id": 1, "name": "Demo Outdoor", "slug": "demo-outdoor"}],
        "categories": [{"id": 1, "name": "Boutique", "slug": "boutique"}],
        "products": [{
          "product_id": 1,
          "name": "Gourde demo",
          "variants": [{
            "variant_id": 10,
            "sku": "DEMO-GOURDE",
            "barcode": "7612345678901",
            "pricing": {"regular_sale_price": "120.00", "final_sale_price": "108.00", "currency": "CHF", "discount": {"label": "Remise POS", "type": "percent", "value": "10.00"}}
          }]
        }],
        "pagination": {"total": 1, "limit": 100, "offset": 0, "has_more": false},
        "sync": {"updated_since": null, "generated_at": "2026-06-27T00:00:00Z"}
      },
      "meta": {"contract": "pos.catalog.bootstrap.v1"}
    }
  }
}
