{
  "contract": "public.content.show.v1",
  "kind": "schema",
  "summary": "Lire un contenu publié par type et slug.",
  "description": "Retourne le payload public normalisé d’une entrée publiée, en réutilisant la projection de route publique.",
  "method": "GET",
  "source": "ResolvePublicRoute::entryPayload + public_content_snapshots",
  "security": "Public read endpoint; may be protected by bearer scope content:read; only published snapshots; invalid type/slug returns validation error.",
  "path": "/api/v1/content/{type}/{slug}",
  "query_params": {
    "site": {
      "type": "string",
      "required": false,
      "description": "Site key actif à cibler explicitement. Si absent, résolution par domaine/base path."
    },
    "site_id": {
      "type": "integer",
      "required": false,
      "minimum": 1,
      "description": "Identifiant technique d'un site actif. Prioritaire sur site si fourni."
    },
    "lang": {
      "type": "string",
      "required": false,
      "pattern": "^[a-z]{2}(?:-[a-z0-9]{2,8})?$",
      "description": "Code langue demandé. Si la langue n'est pas active, fallback sur la langue par défaut du site."
    }
  },
  "path_params": {
    "type": {
      "type": "string",
      "required": true,
      "description": "Type de contenu actif, normalisé en slug sûr."
    },
    "slug": {
      "type": "string",
      "required": true,
      "description": "Slug public du contenu, normalisé en slug sûr."
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "object",
          "required": [
            "kind",
            "site",
            "language",
            "route",
            "content",
            "listing",
            "taxonomies",
            "menus",
            "seo",
            "media",
            "ui"
          ],
          "properties": {
