    "contract": "public.content.show.v1"
  },
  "errors": [
    {
      "code": "PUBLIC_CONTENT_NOT_FOUND",
      "status": 404,
      "description": "Aucun contenu publié ne correspond au couple type/slug.",
      "schema": {
        "$ref": "../admin-api-v1/error.v1.json"
      }
    },
    {
      "code": "VALIDATION_FAILED",
      "status": 422,
      "description": "Type ou slug invalide, ou contexte site/langue invalide.",
      "schema": {
        "$ref": "../admin-api-v1/error.v1.json"
      }
    }
  ],
  "examples": {
    "request": "GET /api/v1/content/article/mon-article?lang=fr",
    "response": {
      "data": "Voir schema public.route.show.v1 / data",
      "meta": {
