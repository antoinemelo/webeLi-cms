              "type": "string"
            },
            "site": {
              "type": "object",
              "required": [
                "id",
                "key",
                "name",
                "base_url",
                "default_language_code"
              ],
              "properties": {
                "id": {
                  "type": "integer"
                },
                "key": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
