{
  "contract": "public.route.show.v1",
  "kind": "schema",
  "summary": "Résoudre une route publique en payload headless complet.",
  "description": "Retourne le même payload public normalisé que le front HTML pour une route donnée : contenu, SEO, menus, taxonomies, médias et listing éventuel. Les redirections retournent un payload redirect avec le statut correspondant.",
  "method": "GET",
  "source": "ResolvePublicRoute + public_content_snapshots",
  "security": "Public read endpoint; may be protected by bearer scope routes:read or content:read; published snapshots only; no draft/preview exposure.",
  "path": "/api/v1/route",
  "query_params": {
    "site": {
      "type": "string",
      "required": false,
      "description": "Site key actif à cibler explicitement. Si absent, résolution par domaine/base path."
    },
    "site_id": {
      "type": "integer",
      "required": false,
      "minimum": 1,
      "description": "Identifiant technique d'un site actif. Prioritaire sur site si fourni."
    },
    "lang": {
      "type": "string",
      "required": false,
      "pattern": "^[a-z]{2}(?:-[a-z0-9]{2,8})?$",
      "description": "Code langue demandé. Si la langue n'est pas active, fallback sur la langue par défaut du site."
    },
    "path": {
      "type": "string",
      "required": false,
      "default": "/",
      "description": "Chemin public à résoudre, normalisé en slash initial, sans query string."
    }
  },
