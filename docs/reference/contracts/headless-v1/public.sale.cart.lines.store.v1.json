{
  "contract": "public.sale.cart.lines.store.v1",
  "kind": "schema",
  "summary": "Ajouter une ligne à un panier public.",
  "description": "Ajoute un sellable stable à un panier public actif. Les prix sont recalculés côté serveur depuis le snapshot catalogue.",
  "method": "POST",
  "path": "/api/v1/sale/channels/{code}/cart/{token}/lines",
  "source": "sale_cart_lines + business sellable snapshot",
  "security": "Public endpoint: no bearer token is required; the opaque cart token is required.",
  "headers": {
    "Idempotency-Key": {"type": "string", "required": false, "description": "Clé optionnelle de rejeu idempotent pour l'ajout de ligne."}
  },
  "query_params": {
    "lang": {"type": "string", "required": false, "description": "Langue active du site."}
  },
  "path_params": {
    "code": {"type": "string", "required": true, "pattern": "^[a-z0-9_-]+$"},
    "token": {"type": "string", "required": true, "pattern": "^[A-Za-z0-9_-]{32,128}$"}
  },
  "request_body": {
    "required": true,
    "schema": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "required": ["sellable_id", "quantity"],
          "properties": {
            "sellable_id": {"type": "integer", "minimum": 1},
            "quantity": {"type": "integer", "minimum": 1},
            "idempotency_key": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "response": {
    "status": 201,
    "schema": {
      "type": "object",
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "object",
          "required": ["cart", "line"],
          "properties": {
            "cart": {"$ref": "#/components/schemas/PublicSaleCart"},
            "line": {"$ref": "#/components/schemas/PublicSaleCartLine"}
          },
          "additionalProperties": true
        },
        "meta": {"$ref": "#/components/schemas/PublicMeta"}
      },
      "additionalProperties": false
    }
  },
  "errors": [
    {"code": "PUBLIC_CONTENT_NOT_FOUND", "status": 404, "description": "Canal, panier ou variante introuvable."},
    {"code": "VALIDATION_FAILED", "status": 422, "description": "Payload, stock ou idempotence invalide."}
  ],
  "examples": {
    "request": {"data": {"sellable_id": 3, "quantity": 1, "idempotency_key": "cart-line-1"}},
    "response": {
      "data": {
        "cart": {"id": 10, "status": "active", "currency": "CHF", "subtotal_minor": 2900, "discount_total_minor": 0, "tax_total_minor": 0, "grand_total_minor": 2900, "lines": []},
        "line": {"id": 20, "sellable_id": 3, "business_variant_id": 3, "quantity": 1, "unit_price_minor": 2900, "currency": "CHF", "line_total_minor": 2900}
      },
      "meta": {"contract": "public.sale.cart.lines.store.v1", "site_id": 1, "language_code": "fr"}
    }
  }
}
