{
  "contract": "public.menus.index.v1",
  "kind": "schema",
  "summary": "Lister les menus publics actifs.",
  "description": "Retourne les menus actifs disponibles pour le site, sans leurs arbres détaillés.",
  "method": "GET",
  "source": "menus active only",
  "security": "Public read endpoint; may be protected by bearer scope menus:read; active menus/items only.",
  "path": "/api/v1/menus",
  "query_params": {
    "site": {
      "type": "string",
      "required": false,
      "description": "Site key actif à cibler explicitement. Si absent, résolution par domaine/base path."
    },
    "site_id": {
      "type": "integer",
      "required": false,
      "minimum": 1,
      "description": "Identifiant technique d'un site actif. Prioritaire sur site si fourni."
    },
    "lang": {
      "type": "string",
      "required": false,
      "pattern": "^[a-z]{2}(?:-[a-z0-9]{2,8})?$",
      "description": "Code langue demandé. Si la langue n'est pas active, fallback sur la langue par défaut du site."
    }
  },
  "path_params": {},
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "location",
                  "name",
                  "language_mode",
                  "item_count"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "location": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "name": {
                    "type": "string"
                  },
                  "language_mode": {
                    "type": "string"
                  },
                  "item_count": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "meta": {
          "type": "object",
          "required": [
            "contract",
            "request_id"
          ],
          "properties": {
            "contract": {
              "type": "string"
            },
            "request_id": {
              "type": "string"
            },
            "site_id": {
              "type": "integer"
            },
            "language_code": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      }
    },
    "contract": "public.menus.index.v1"
  },
  "errors": [
    {
      "code": "VALIDATION_FAILED",
      "status": 422,
      "description": "Contexte site/langue invalide.",
      "schema": {
        "$ref": "../admin-api-v1/error.v1.json"
      }
    }
  ],
  "examples": {
    "request": "GET /api/v1/menus?lang=fr",
    "response": {
      "data": {
        "items": [
          {
            "key": "primary",
            "location": "header",
            "name": "Menu principal",
            "language_mode": "shared",
            "item_count": 4
          }
        ]
      },
      "meta": {
        "contract": "public.menus.index.v1",
        "request_id": "20260604120000-abc",
        "site_id": 1,
        "language_code": "fr"
      }
    }
  }
}
