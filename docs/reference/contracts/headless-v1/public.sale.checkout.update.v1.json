{
  "contract": "public.sale.checkout.update.v1",
  "kind": "schema",
  "summary": "Compléter et recalculer un checkout invité.",
  "description": "Enregistre une étape du checkout et recalcule les lignes depuis le catalogue serveur à l'étape review.",
  "method": "PATCH",
  "path": "/api/v1/sale/channels/{code}/cart/{token}/checkout",
  "source": "sale_carts + sale_cart_lines",
  "security": "Public endpoint protected by the opaque cart token and rate limiting.",
  "path_params": {
    "code": {"type": "string", "required": true, "pattern": "^[a-z0-9_-]+$"},
    "token": {"type": "string", "required": true, "pattern": "^[A-Za-z0-9_-]{32,128}$"}
  },
  "request_body": {
    "required": true,
    "schema": {
      "type": "object",
      "properties": {"data": {"type": "object", "properties": {
        "step": {"type": "string", "enum": ["identity", "addresses", "delivery", "review"]},
        "identity": {"$ref": "#/components/schemas/PublicSaleGuestIdentity"},
        "billing_address": {"$ref": "#/components/schemas/PublicSaleAddress"},
        "shipping_address": {"$ref": "#/components/schemas/PublicSaleAddress"},
        "shipping_same_as_billing": {"type": "boolean"},
        "shipping_method": {"type": "object", "properties": {"code": {"type": "string", "enum": ["standard", "pickup"]}}},
        "payment": {"type": "object", "properties": {"code": {"type": "string", "enum": ["bank_transfer", "manual"]}}},
        "terms_accepted": {"type": "boolean"},
        "marketing_consent": {"type": "boolean"}
      }, "additionalProperties": false}},
      "additionalProperties": false
    }
  },
  "response": {"status": 200, "schema": {"type": "object", "required": ["data", "meta"], "properties": {
    "data": {"type": "object", "required": ["cart", "price_changed"], "properties": {"cart": {"$ref": "#/components/schemas/PublicSaleCart"}, "price_changed": {"type": "boolean"}}},
    "meta": {"$ref": "#/components/schemas/PublicMeta"}
  }}},
  "errors": [
    {"code": "PUBLIC_CONTENT_NOT_FOUND", "status": 404, "description": "Panier introuvable, expiré ou appartenant à un autre token."},
    {"code": "VALIDATION_FAILED", "status": 422, "description": "Données invalides ou produit indisponible."},
    {"code": "RATE_LIMIT_EXCEEDED", "status": 429, "description": "Trop de validations."}
  ],
  "examples": {"request": {"data": {"step": "review", "identity": {"email": "guest@example.test", "first_name": "Anne", "last_name": "Exemple"}, "marketing_consent": false}}, "response": {"data": {"cart": {"id": 10, "status": "active", "currency": "CHF", "subtotal_minor": 2900, "discount_total_minor": 0, "tax_total_minor": 0, "grand_total_minor": 2900, "lines": []}, "price_changed": false}, "meta": {"contract": "public.sale.checkout.update.v1", "site_id": 1, "language_code": "fr"}}}
}
