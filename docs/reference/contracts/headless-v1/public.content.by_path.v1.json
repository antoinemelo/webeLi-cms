{
  "contract": "public.content.by_path.v1",
  "kind": "schema",
  "summary": "Lire un contenu publié par chemin canonique.",
  "description": "Alias de compatibilité v1 servi par PublicHeadlessController::contentByPath. Il retourne l’ancien contrat détaillé system/editorial/seo/blocks/media/links/meta pour un chemin publié.",
  "method": "GET",
  "source": "PublicHeadlessController::contentByPath + public_content_snapshots",
  "security": "Public read endpoint; may be protected by bearer scope content:read; published snapshots only; legacy response shape preserved.",
  "path": "/api/v1/content-by-path",
  "query_params": {
    "site": {
      "type": "string",
      "required": false,
      "description": "Site key actif à cibler explicitement. Si absent, résolution par domaine/base path."
    },
    "site_id": {
      "type": "integer",
      "required": false,
      "minimum": 1,
      "description": "Identifiant technique d'un site actif. Prioritaire sur site si fourni."
    },
    "lang": {
      "type": "string",
      "required": false,
      "pattern": "^[a-z]{2}(?:-[a-z0-9]{2,8})?$",
      "description": "Code langue demandé. Si la langue n'est pas active, fallback sur la langue par défaut du site."
    },
    "path": {
      "type": "string",
      "required": false,
      "default": "/",
      "description": "Chemin canonique public à lire."
    }
  },
  "path_params": {},
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "object",
          "required": [
            "system",
            "editorial",
            "seo",
            "blocks",
            "media",
            "links",
            "meta"
          ],
          "properties": {
            "system": {
              "type": "object",
              "required": [
                "id",
                "site_id",
                "content_type",
                "entry_key",
                "language_code",
                "status",
                "published_at",
                "source_revision_id"
              ],
              "properties": {
                "id": {
                  "type": "integer"
                },
                "site_id": {
                  "type": "integer"
                },
                "content_type": {
                  "type": "string"
                },
                "entry_key": {
                  "type": "string"
                },
                "language_code": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "published"
                  ]
                },
                "published_at": {
                  "type": "string"
                },
                "source_revision_id": {
                  "type": "integer"
                }
              }
            },
            "editorial": {
              "type": "object",
              "required": [
                "title",
                "slug",
                "path",
                "fields",
                "published_at",
                "published_at_label",
                "author_name",
                "display"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "slug": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "fields": {
                  "type": "object",
                  "additionalProperties": true
                },
                "published_at": {
                  "type": "string"
                },
                "published_at_label": {
                  "type": "string"
                },
                "author_name": {
                  "type": "string"
                },
                "display": {
                  "type": "object",
                  "required": [
                    "show_published_date",
                    "show_author",
                    "show_updated_date",
                    "show_type",
                    "include_author_in_schema",
                    "date_format"
                  ],
                  "properties": {
                    "show_published_date": {
                      "type": "boolean"
                    },
                    "show_author": {
                      "type": "boolean"
                    },
                    "show_updated_date": {
                      "type": "boolean"
                    },
                    "show_type": {
                      "type": "boolean"
                    },
                    "include_author_in_schema": {
                      "type": "boolean"
                    },
                    "date_format": {
                      "type": "string",
                      "enum": [
                        "short",
                        "medium",
                        "long",
                        "iso"
                      ]
                    }
                  }
                }
              }
            },
            "seo": {
              "type": "object",
              "required": [
                "meta_title",
                "meta_description",
                "meta_robots",
                "canonical_url",
                "json_ld",
                "hreflang_code"
              ],
              "properties": {
                "meta_title": {
                  "type": "string"
                },
                "meta_description": {
                  "type": "string"
                },
                "meta_robots": {
                  "type": "string"
                },
                "canonical_url": {
                  "type": "string"
                },
                "json_ld": {
                  "type": [
                    "object",
                    "array",
                    "string",
                    "null"
                  ]
                },
                "hreflang_code": {
                  "type": "string"
                }
              }
            },
            "blocks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "media": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "links": {
              "type": "object",
              "required": [
                "canonical",
                "hreflang"
              ],
              "properties": {
                "canonical": {
                  "type": "string"
                },
                "hreflang": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            },
            "meta": {
              "type": "object",
              "required": [
                "source",
                "projected_at",
                "blueprint"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "projected_at": {
                  "type": "string"
                },
                "blueprint": {
                  "type": [
                    "object",
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "meta": {
          "type": "object",
          "required": [
            "contract",
            "request_id"
          ],
          "properties": {
            "contract": {
              "type": "string"
            },
            "request_id": {
              "type": "string"
            },
            "site_id": {
              "type": "integer"
            },
            "language_code": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      }
    },
    "contract": "public.content.by_path.v1"
  },
  "errors": [
    {
      "code": "PUBLIC_CONTENT_NOT_FOUND",
      "status": 404,
      "description": "Aucun contenu publié ne correspond au chemin.",
      "schema": {
        "$ref": "../admin-api-v1/error.v1.json"
      }
    },
    {
      "code": "VALIDATION_FAILED",
      "status": 422,
      "description": "Contexte site/langue invalide.",
      "schema": {
        "$ref": "../admin-api-v1/error.v1.json"
      }
    }
  ],
  "examples": {
    "request": "GET /api/v1/content-by-path?path=/articles/mon-article&lang=fr",
    "response": {
      "data": {
        "system": {
          "id": 42,
          "site_id": 1,
          "content_type": "article",
          "entry_key": "mon-article",
          "language_code": "fr",
          "status": "published",
          "published_at": "2026-05-01 10:00:00",
          "source_revision_id": 7
        },
        "editorial": {
          "title": "Mon article",
          "slug": "mon-article",
          "path": "/articles/mon-article",
          "fields": {},
          "published_at": "2026-05-01 10:00:00",
          "published_at_label": "1 mai 2026",
          "author_name": "",
          "display": {
            "show_published_date": true,
            "show_author": true,
            "show_updated_date": false,
            "show_type": true,
            "include_author_in_schema": true,
            "date_format": "medium"
          }
        },
        "seo": {
          "meta_title": "Mon article",
          "meta_description": "Résumé",
          "meta_robots": "index,follow",
          "canonical_url": "/articles/mon-article",
          "json_ld": null,
          "hreflang_code": "fr"
        },
        "blocks": [],
        "media": [],
        "links": {
          "canonical": "/articles/mon-article",
          "hreflang": []
        },
        "meta": {
          "source": "public_content_snapshots",
          "projected_at": "2026-05-01 10:00:00",
          "blueprint": null
        }
      },
      "meta": {
        "contract": "public.content.by_path.v1",
        "request_id": "20260604120000-abc",
        "site_id": 1,
        "language_code": "fr",
        "path": "/articles/mon-article",
        "source": "public_content_snapshots"
      }
    }
  }
}
