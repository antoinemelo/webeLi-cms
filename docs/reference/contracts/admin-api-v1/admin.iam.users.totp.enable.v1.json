      "code": "6 digit TOTP code required for TOTP activation"
    }
  },
  "response": {
    "data": {
      "user": "iam user summary including login_mode",
      "recovery_codes": "non-empty one-use recovery codes for TOTP activation; empty only when mode=email_code compatibility path is used",
      "message": "Deprecated compatibility endpoint. Prefer /login-mode or /login-mode/totp/confirm."
    },
    "meta": {
      "contract": "admin.iam.users.totp.enable.v1",
      "request_id": "...",
      "contract_version": "admin-api-v1"
    }
  },
  "errors": [
