{
  "contract": "admin.iam.users.totp.enable.v1",
  "methods": [
    "POST"
  ],
  "permission": "users.manage",
  "headers": {
    "write_requests": {
      "Content-Type": "application/json",
      "X-CSRF-Token": "required",
      "X-Contract-Version": "admin-api-v1"
    }
  },
  "request": {
    "POST": {
      "required": "optional boolean, default true",
