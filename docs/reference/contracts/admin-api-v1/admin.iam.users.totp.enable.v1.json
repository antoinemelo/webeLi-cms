    "CONTRACT_VERSION_UNSUPPORTED",
    "VALIDATION_FAILED",
    "INTERNAL_SERVER_ERROR"
  ],
  "supported_versions": [
    "admin-api-v1"
  ],
  "path": "/admin/api/iam/users/{id}/totp/enable"
