{
  "contract": "admin.media.settings.v1",
  "method": "GET",
  "path": "/admin/api/media/settings",
  "permission": "media.read",
  "query": {
    "site_id": "optional integer"
  },
  "response": {
    "data": {
      "max_upload_mb": 12,
      "allowed_mime_types": [
        "image/jpeg",
        "image/png",
        "image/webp",
        "application/pdf"
      ],
      "auto_generate_variants": true,
      "require_alt_text": true,
      "default_folder_key": "general",
      "default_social_image_media_id": null,
      "social_image_policy": {
        "required_width": 1200,
        "required_height": 630,
        "variant_key": "og_1200x630"
      }
    },
    "meta": {
      "contract": "admin.media.settings.v1",
      "request_id": "...",
      "site_id": 1
    }
  },
  "errors": [
    "AUTH_REQUIRED",
    "AUTHZ_FORBIDDEN",
    "CSRF_TOKEN_REJECTED",
    "VALIDATION_FAILED",
    "SITE_NOT_FOUND",
    "MEDIA_NOT_FOUND",
    "MEDIA_UPLOAD_FAILED"
  ],
  "supported_versions": [
    "admin-api-v1"
  ]
}
