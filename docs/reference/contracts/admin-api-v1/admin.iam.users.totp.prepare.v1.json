{
  "contract": "admin.iam.users.totp.prepare.v1",
  "methods": [
    "POST"
  ],
  "permission": "users.manage",
  "headers": {
    "write_requests": {
      "Content-Type": "application/json",
      "X-CSRF-Token": "required",
      "X-Contract-Version": "admin-api-v1"
    }
  },
  "request": {
    "POST": {
      "issuer": "optional string, default DEC CMS"
    }
  },
  "response": {
    "data": {
      "totp": {
        "user_id": "integer",
        "email": "user email",
        "mode": "totp",
        "secret": "Base32 secret returned only before activation",
        "manual_entry_key": "same Base32 secret for manual entry",
        "otpauth_uri": "otpauth://totp/...",
        "qr_payload": "same value as otpauth_uri",
        "algorithm": "SHA1",
        "digits": 6,
        "period": 30
      },
      "message": "Deprecated compatibility endpoint. Prefer /login-mode/totp/prepare."
    },
    "meta": {
      "contract": "admin.iam.users.totp.prepare.v1",
      "request_id": "...",
      "contract_version": "admin-api-v1"
    }
  },
  "errors": [
    "AUTH_REQUIRED",
    "AUTHZ_FORBIDDEN",
    "CSRF_TOKEN_REJECTED",
    "CONTRACT_VERSION_UNSUPPORTED",
    "VALIDATION_FAILED",
    "INTERNAL_SERVER_ERROR"
  ],
  "supported_versions": [
    "admin-api-v1"
  ],
  "path": "/admin/api/iam/users/{id}/totp/prepare"
}
