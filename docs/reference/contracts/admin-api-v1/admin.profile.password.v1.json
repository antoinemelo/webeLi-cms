{
  "contract": "admin.profile.password.v1",
  "method": "PATCH",
  "path": "/admin/api/profile/password",
  "permission": "authenticated user",
  "headers": {
    "Content-Type": "application/json",
    "X-CSRF-Token": "required",
    "X-Contract-Version": "admin-api-v1"
  },
  "request": {
    "data": {
      "current_password": "required string",
      "new_password": "required string, 12-255 chars, lowercase + uppercase + digit, different from current password",
      "confirm_password": "required string, must match new_password"
    }
  },
  "response": {
    "data": {
      "message": "Mot de passe modifié. Les autres sessions du compte ont été révoquées."
    },
    "meta": {
      "contract": "admin.profile.password.v1",
      "request_id": "...",
      "contract_version": "admin-api-v1"
    }
  },
  "errors": [
    "AUTH_REQUIRED",
    "CSRF_TOKEN_REJECTED",
    "INVALID_JSON",
    "JSON_CONTENT_TYPE_REQUIRED",
    "CONTRACT_VERSION_UNSUPPORTED",
    "VALIDATION_FAILED",
    "INTERNAL_SERVER_ERROR"
  ],
  "audit": [
    "auth.password_changed",
    "auth.password_change_failed"
  ],
  "security": {
    "current_password_required": true,
    "password_hashing": "password_hash(..., PASSWORD_DEFAULT)",
    "session_policy": "current session kept, other sessions for the same account revoked"
  },
  "supported_versions": [
    "admin-api-v1"
  ]
}
