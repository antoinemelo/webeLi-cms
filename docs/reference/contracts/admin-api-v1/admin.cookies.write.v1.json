{
  "contract": "admin.cookies.write.v1",
  "methods": [
    "PATCH",
    "POST"
  ],
  "paths": [
    "/admin/api/cookies/settings",
    "/admin/api/cookies/categories",
    "/admin/api/cookies/categories/{id}",
    "/admin/api/cookies/services",
    "/admin/api/cookies/services/{id}",
    "/admin/api/cookies/bindings",
    "/admin/api/cookies/bindings/{id}"
  ],
  "permissions": {
    "write": "cookies.manage"
  },
  "headers": {
    "POST": {
      "Content-Type": "application/json",
      "X-CSRF-Token": "required",
      "X-Contract-Version": "admin-api-v1"
    },
    "PATCH": {
      "Content-Type": "application/json",
      "X-CSRF-Token": "required",
      "X-Contract-Version": "admin-api-v1"
    }
  },
  "query": {
    "lang": "optional language code used for translated settings/categories/services",
    "content_language_code": "optional alias for lang"
  },
  "request": {
    "data": {
      "settings": "for /settings: enabled, banner_position, consent_ttl_days, theme, legal texts",
      "category": "for /categories: key, required/enabled flags, sort order, title, description",
      "service": "for /services: category_id, name, provider, purpose, duration, type, domain, privacy URL",
      "binding": "for /bindings: service_id, selector, script_type, source_url, enabled flag"
    }
  },
  "response": {
    "data": {
      "resource": "updated settings, category, service or script binding according to endpoint",
      "id": "integer when a row resource is returned"
    },
    "meta": {
      "contract": "admin.cookies.write.v1",
      "contract_version": "admin-api-v1",
      "site_id": "integer",
      "language_code": "string",
      "request_id": "string"
    }
  },
  "errors": [
    "AUTH_REQUIRED",
    "AUTHZ_FORBIDDEN",
    "CSRF_TOKEN_REJECTED",
    "INVALID_JSON",
    "JSON_CONTENT_TYPE_REQUIRED",
    "CONTRACT_VERSION_UNSUPPORTED",
    "VALIDATION_FAILED",
    "SITE_NOT_FOUND",
    "LANGUAGE_NOT_ENABLED",
    "INTERNAL_SERVER_ERROR"
  ],
  "supported_versions": [
    "admin-api-v1"
  ]
}
