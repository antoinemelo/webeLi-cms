{
  "contract": "admin.menus.write.v1",
  "methods": [
    "POST",
    "PATCH"
  ],
  "paths": [
    "/admin/api/menus",
    "/admin/api/menus/{key}"
  ],
  "permission": "menu.manage",
  "request": {
    "data": {
      "menu_key": "main",
      "menu_location": "header",
      "name": "Menu principal",
      "language_mode": "shared",
      "is_active": true
    }
  },
  "response": {
    "data": {
      "id": 1,
      "menu_key": "main",
      "menu_location": "header",
      "name": "Menu principal",
      "language_mode": "shared",
      "is_active": 1
    },
    "meta": {
      "contract": "admin.menus.write.v1",
      "request_id": "...",
      "site_id": 1,
      "language_code": "fr"
    }
  },
  "notes": [
    "menu_location accepte notamment header, footer, sidebar, mobile ou custom côté back-office.",
    "language_mode accepte shared ou localized."
  ],
  "errors": [
    "AUTH_REQUIRED",
    "AUTHZ_FORBIDDEN",
    "CSRF_TOKEN_REJECTED",
    "VALIDATION_FAILED",
    "SITE_NOT_FOUND",
    "MENU_NOT_FOUND"
  ],
  "supported_versions": [
    "admin-api-v1"
  ]
}
