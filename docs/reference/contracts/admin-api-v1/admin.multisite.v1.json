{
  "contract": "admin.multisite.v1",
  "methods": [
    "GET",
    "POST",
    "DELETE"
  ],
  "paths": [
    "/admin/api/multisite",
    "/admin/api/multisite/sites",
    "/admin/api/multisite/sites/{id}"
  ],
  "permissions": {
    "read": "settings.read",
    "create": "settings.manage",
    "delete": "settings.manage",
    "scope": "main site only"
  },
  "headers": {
    "POST": {
      "Content-Type": "application/json",
      "X-CSRF-Token": "required",
      "X-Contract-Version": "admin-api-v1"
    },
    "DELETE": {
      "Content-Type": "application/json",
      "X-CSRF-Token": "required",
      "X-Contract-Version": "admin-api-v1"
    }
  },
  "query": {
    "site_id": "optional integer; must resolve to the main site for multisite management",
    "content_language_code": "optional content language code",
    "ui_language_code": "optional admin interface language code: fr | en"
  },
  "request": {
    "POST /admin/api/multisite/sites": {
      "data": {
        "site_key": "required stable key, unique, [a-z0-9_-]",
        "name": "required display name",
        "primary_domain_host": "required host without scheme/path",
        "base_path": "optional public base path, empty or /path without trailing slash",
        "default_language_code": "required active language code",
        "scheme": "optional http | https, default https",
        "enforce_https": "optional boolean, default true",
        "is_active": "optional boolean, default true"
      }
    },
    "DELETE /admin/api/multisite/sites/{id}": {
      "data": {}
    }
  },
  "response": {
    "data": {
      "main_site": "site object returned by GET /admin/api/multisite",
      "subsites": [
        {
          "id": "integer",
          "site_key": "string",
          "name": "string",
          "default_language_code": "string",
          "is_active": "boolean",
          "host": "string",
          "base_path": "string",
          "scheme": "http | https",
          "enforce_https": "boolean",
          "public_url": "string",
          "admin_path": "string",
          "content_count": "integer",
          "language_count": "integer",
          "created_at": "string",
          "updated_at": "string"
        }
      ],
      "defaults": {
        "default_language_code": "string",
        "scheme": "string",
        "enforce_https": "boolean"
      },
      "actions": {
        "index": {
          "method": "GET",
          "path": "/admin/api/multisite"
        },
        "store": {
          "method": "POST",
          "path": "/admin/api/multisite/sites"
        },
        "destroy": {
          "method": "DELETE",
          "path": "/admin/api/multisite/sites/{id}"
        }
      }
    },
    "mutations": {
      "create": {
        "site": "created site object",
        "multisite": "fresh overview payload"
      },
      "destroy": {
        "result": {
          "deleted_site_id": "integer",
          "status": "deleted"
        },
        "multisite": "fresh overview payload"
      }
    },
    "meta": {
      "contract": "admin.multisite.v1",
      "contract_version": "admin-api-v1",
      "site_id": "integer",
      "language_code": "string",
      "request_id": "string"
    }
  },
  "errors": [
    "AUTH_REQUIRED",
    "AUTHZ_FORBIDDEN",
    "CSRF_TOKEN_REJECTED",
    "INVALID_JSON",
    "JSON_CONTENT_TYPE_REQUIRED",
    "CONTRACT_VERSION_UNSUPPORTED",
    "VALIDATION_FAILED",
    "SITE_NOT_FOUND",
    "INTERNAL_SERVER_ERROR"
  ],
  "supported_versions": [
    "admin-api-v1"
  ]
}
