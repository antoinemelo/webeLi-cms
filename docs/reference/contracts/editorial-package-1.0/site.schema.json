{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://am-cms.local/schemas/editorial-package/1.0/site.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["site_key", "name", "default_language", "languages"],
  "properties": {
    "site_key": {"$ref": "definitions.schema.json#/$defs/portableKey"}, "name": {"type": "string", "minLength": 1},
    "default_language": {"$ref": "definitions.schema.json#/$defs/language"},
    "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "definitions.schema.json#/$defs/language"}},
    "metadata": {"type": "object"}
  }
}
