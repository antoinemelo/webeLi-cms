{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://am-cms.local/schemas/editorial-package/1.0/editorial-package.schema.json",
  "title": "Editorial Package manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "minimum_cms_version", "release_id", "generated_at", "source_site_key", "languages", "scope", "counts", "hash_algorithm", "published_only", "contains_drafts", "contains_history", "files"],
  "properties": {
    "format": {"const": "Editorial Package"},
    "format_version": {"const": "1.0"},
    "minimum_cms_version": {"type": "string", "minLength": 1},
    "release_id": {"$ref": "definitions.schema.json#/$defs/portableKey"},
    "generated_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "source_site_key": {"$ref": "definitions.schema.json#/$defs/portableKey"},
    "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "definitions.schema.json#/$defs/language"}},
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["type", "value"],
      "properties": {"type": {"enum": ["page", "language", "site"]}, "value": {"type": ["string", "null"]}}
    },
    "counts": {
      "type": "object", "additionalProperties": false, "required": ["entries", "blueprints", "media"],
      "properties": {"entries": {"type": "integer", "minimum": 0}, "blueprints": {"type": "integer", "minimum": 0}, "media": {"type": "integer", "minimum": 0}}
    },
    "hash_algorithm": {"const": "sha256"},
    "published_only": {"const": true},
    "contains_drafts": {"const": false},
    "contains_history": {"const": false},
    "files": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size"], "properties": {"path": {"$ref": "definitions.schema.json#/$defs/relativePath"}, "sha256": {"$ref": "definitions.schema.json#/$defs/sha256"}, "size": {"type": "integer", "minimum": 0}}}
    }
  }
}
