Options -Indexes
RewriteEngine On
AddDefaultCharset UTF-8

# Transmettre Authorization à PHP/FastCGI pour l'API headless Bearer.
SetEnvIfNoCase Authorization "^(.*)$" HTTP_AUTHORIZATION=$1
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Défense en profondeur si le document root pointe sur la racine du package.
RewriteRule ^(?:storage|database|tools|ops)(?:/|$) - [F,L]
RewriteRule ^(?:config)(?:/|$) - [F,L]
RewriteRule (^|/)\.(?:env|git|svn|hg) - [F,L]

# Documentation publique headless : passer par le front controller.
# IMPORTANT : ces règles doivent être placées AVANT le blocage générique des fichiers .json/.yaml.
# Les deux règles avec préfixe autorisent aussi les sous-sites montés sous le base path
# de l'installation, par exemple /mod/site-b/docs/public-api/openapi.v1.json.
RewriteRule ^docs/public-api/?$ index.php [QSA,L]
RewriteRule ^docs/public-api/(index\.html|openapi\.v1\.json|openapi\.v1\.yaml|quickstart\.md|authentication\.md|errors\.md|examples\.md)$ index.php [QSA,L]
RewriteRule ^(?:[^/]+/)*docs/public-api/?$ index.php [QSA,L]
RewriteRule ^(?:[^/]+/)*docs/public-api/(index\.html|openapi\.v1\.json|openapi\.v1\.yaml|quickstart\.md|authentication\.md|errors\.md|examples\.md)$ index.php [QSA,L]

# Spécifications OpenAPI exposées nativement par l'API publique. Ces exceptions
# doivent elles aussi précéder le blocage générique des fichiers JSON/YAML.
RewriteRule ^api/v1/openapi\.(json|yaml)$ index.php [QSA,L]
RewriteRule ^(?:[^/]+/)*api/v1/openapi\.(json|yaml)$ index.php [QSA,L]

# Manifeste public de versions et migrations utilisé par les canaux de mise à jour.
# Cette route JSON est produite par le front controller et doit rester accessible.
RewriteRule ^updates/manifest\.json$ index.php [QSA,L]
RewriteRule ^(?:[^/]+/)*updates/manifest\.json$ index.php [QSA,L]

# Bloquer les fichiers sensibles, temporaires, archives et JSON non explicitement exposés.
RewriteRule \.(?:sqlite(?:-(?:wal|shm|journal))?|db|sql|log|bak|backup|ini|env|yml|yaml|jsonl?|zip|tar|tgz|gz)$ - [F,L]

# Servir directement les fichiers et dossiers publics existants.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Tout le reste passe par le front controller.
RewriteRule ^ index.php [QSA,L]
