FROM docker.io/library/node:22-bookworm-slim AS node_runtime
FROM docker.io/library/composer:2 AS composer_runtime
FROM docker.io/library/php:8.4-cli-bookworm

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        jq \
        libsqlite3-dev \
        python3 \
        python3-venv \
        sqlite3 \
        unzip \
        zip \
    && docker-php-ext-install pdo_sqlite \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node_runtime /usr/local/ /usr/local/
COPY --from=composer_runtime /usr/bin/composer /usr/local/bin/composer
COPY tools/audit/run-audit.sh /usr/local/bin/run-cms-audit

RUN chmod +x /usr/local/bin/run-cms-audit \
    && php --ri pdo_sqlite \
    && composer --version \
    && python3 --version \
    && node --version \
    && npm --version

WORKDIR /audit/work
ENTRYPOINT ["run-cms-audit"]
