{
  "name": "@amcms/client",
  "version": "0.1.0",
  "description": "Minimal TypeScript fetch client for the DEC CMS public headless v1 API.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "am-cms",
    "headless",
    "cms",
    "typescript",
    "fetch"
  ],
  "license": "MIT"
}
