# Public media delivery.
# This file intentionally reopens storage/media because storage/.htaccess keeps the rest
# of storage private. Keep executable/server-side files blocked.
Options -Indexes

<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

<IfModule mod_access_compat.c>
    Order allow,deny
    Allow from all
    Satisfy Any
</IfModule>

<FilesMatch "\.(?:php[0-9]?|phtml|phar|cgi|pl|py|rb|sh|bash|zsh|bat|cmd|exe|dll|so|ini|env|sqlite|db|sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule mod_access_compat.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^quarantine(?:/|$) - [F,L]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
