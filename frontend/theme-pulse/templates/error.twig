<section class="hero hero--compact status-page pulse-status" aria-labelledby="status-title" role="alert">
  <div class="status-code" aria-hidden="true">{{ status|default(404) }}</div>
  <h1 id="status-title">{{ error_title|default(ui.not_found_title) }}</h1>
  <p>{{ error_message|default(ui.not_found_text) }}</p>
  <div class="actions">
    <a class="btn btn--primary" href="{{ localized_home_url }}">{{ ui.back_home }}</a>
    <a class="btn btn--ghost" href="{{ localized_search_url }}">{{ ui.search }}</a>
  </div>
</section>
