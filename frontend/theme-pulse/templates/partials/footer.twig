<footer class="site-footer border-top bg-white py-4 mt-auto">
  <div class="container">
    <div class="row gy-3 align-items-start">
      <section class="col-lg" aria-label="{{ site_localization.site_title|default(site.name|default(app_name)) }}">
        <strong class="d-block text-body">{{ site_localization.site_title|default(site.name|default(app_name)) }}</strong>
        <p class="mb-0 text-body-secondary">{{ site_localization.footer_text|default('CMS éditorial SEO-first, runtime léger.') }}</p>
      </section>

      {% set footer_top = footer_top_menu_items|default([]) %}
      {% set footer_bottom = footer_bottom_menu_items|default([]) %}
      {% if footer_top is empty and footer_bottom is empty and footer_menu_items|default([]) is not empty %}
        {% set footer_top = footer_menu_items|slice(0, 3) %}
        {% set footer_bottom = footer_menu_items|slice(3) %}
      {% endif %}

      <nav class="col-lg-auto footer-links" aria-label="{{ ui.footer_navigation }}">
        <div class="footer-links__legal d-flex flex-column flex-lg-row gap-2 gap-lg-3 mb-2 mb-lg-1">
{% for item in footer_top %}
          <a class="{{ item.css_class|default('') }}" href="{{ item.url }}"{% if item.target|default('_self') == '_blank' %} target="_blank" rel="noopener noreferrer"{% endif %}{% if item.title_attr|default('') %} title="{{ item.title_attr }}"{% endif %}>{{ item.label }}</a>
{% else %}
          <a href="{{ localized_url('/mentions-legales', languageCode) }}">{{ ui.legal }}</a>
          <a href="{{ localized_url('/politique-confidentialite', languageCode) }}">{{ ui.privacy }}</a>
          <a href="{{ localized_url('/cookies', languageCode) }}">{{ ui.cookies }}</a>
{% endfor %}
        </div>

        <div class="footer-links__secondary d-flex flex-wrap justify-content-lg-end gap-2 gap-lg-3">
{% for item in footer_bottom %}
          <a class="{{ item.css_class|default('') }}" href="{{ item.url }}"{% if item.target|default('_self') == '_blank' %} target="_blank" rel="noopener noreferrer"{% endif %}{% if item.title_attr|default('') %} title="{{ item.title_attr }}"{% endif %}>{{ item.label }}</a>
{% else %}
          <a href="{{ localized_url('/contact', languageCode) }}">{{ ui.contact }}</a>
          <a href="{{ localized_url('/sitemap', languageCode) }}">{{ ui.sitemap }}</a>
{% endfor %}
        </div>
      </nav>
    </div>
  </div>
</footer>
