{% set filter = article_filter|default({}) %}
{% set facets = article_facets|default({ categories: [], tags: [] }) %}
{% set items = article_items|default([]) %}
{% set display = article_display|default({ show_published_date: true, show_author: false }) %}

<section class="articles-index py-3 py-lg-4" aria-labelledby="articles-index-title">
  {% if article_index_blocks_before|default([]) %}
    <div class="articles-index__blocks articles-index__blocks--before mb-4">
      {% include 'partials/content-blocks.twig' with { entry_blocks: article_index_blocks_before, is_preview: is_preview|default(false), visual_editing: visual_editing|default(false) } only %}
    </div>
  {% else %}
    <header class="articles-index__hero mb-4">
      <h1 id="articles-index-title" class="display-4 fw-bold text-primary-emphasis mb-2">{{ entry_title|default(title) }}</h1>
      {% if entry_summary|default('') %}<p class="lead text-secondary mb-0">{{ entry_summary }}</p>{% endif %}
    </header>
  {% endif %}

  <div class="row g-4 align-items-start">
    <aside class="col-12 col-lg-3" aria-label="{{ ui.article_filters }}">
      <div class="articles-filter-card card border-0 rounded-4 shadow-sm sticky-lg-top">
        <div class="card-body p-3 p-xl-4">
          <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
            <span class="eyebrow">{{ ui.article_filters }}</span>
            <a href="{{ filter.clear_url }}" class="articles-filter-card__clear fw-bold text-decoration-none">{{ ui.all_articles }}</a>
          </div>

          {% if facets.categories|default([]) %}
            <section class="mb-4" aria-labelledby="article-categories-title">
              <h2 id="article-categories-title" class="h6 fw-bold text-primary-emphasis mb-2">{{ ui.categories }}</h2>
              <div class="list-group list-group-flush rounded-3 overflow-hidden" aria-label="{{ ui.categories }}">
                {% for category in facets.categories %}
                  <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between gap-2{% if category.slug == filter.category|default('') %} active{% endif %}" href="{{ category.url }}">
                    <span>{{ category.name }}</span>
                    <span class="badge rounded-pill text-bg-light">{{ category.count }}</span>
                  </a>
                {% endfor %}
              </div>
            </section>
          {% endif %}

          {% if facets.tags|default([]) %}
            <section aria-labelledby="article-tags-title">
              <h2 id="article-tags-title" class="h6 fw-bold text-primary-emphasis mb-2">{{ ui.popular_tags }}</h2>
              <div class="d-flex flex-wrap gap-2" aria-label="{{ ui.popular_tags }}">
                {% for tag in facets.tags %}
                  <a class="badge rounded-pill text-decoration-none px-3 py-2 {% if tag.slug == filter.tag|default('') %}text-bg-primary{% else %}text-bg-light text-primary-emphasis border{% endif %}" href="{{ tag.url }}">#{{ tag.name }}</a>
                {% endfor %}
              </div>
            </section>
          {% endif %}
        </div>
      </div>
    </aside>

    <main class="col-12 col-lg-9" aria-labelledby="articles-index-title">
      {% if items %}
        <div class="row row-cols-1 row-cols-md-2 g-3 g-xl-4">
          {% for item in items %}
            <div class="col">
              <article class="article-card card h-100 border-0 rounded-4 shadow-sm overflow-hidden">
                <div class="card-body p-4">
                  {% set show_type = display.show_type and item.categories|default([]) %}
                  {% set show_published_date = display.show_published_date and item.published_at %}
                  {% set show_updated_date = (display.show_updated_date|default(false)) and item.updated_at and item.updated_at != item.published_at %}
                  {% set show_author = display.show_author and item.author_name %}
                  {% set has_meta = show_type or show_published_date or show_updated_date or show_author %}
                  {% if has_meta %}
                    <div class="article-card__meta small fw-semibold text-secondary mb-3">
                      {% if show_type %}<a class="article-card__meta-item text-decoration-none" href="{{ item.categories[0].url }}">{{ item.categories[0].name }}</a>{% endif %}
                      {% if show_published_date %}<time class="article-card__meta-item" datetime="{{ item.published_at|date('c') }}">{{ item.published_at_label|default(item.published_at|date('d.m.Y')) }}</time>{% endif %}
                      {% if show_updated_date %}<time class="article-card__meta-item" datetime="{{ item.updated_at|date('c') }}">{{ item.updated_at_label|default(item.updated_at|date('d.m.Y')) }}</time>{% endif %}
                      {% if show_author %}<span class="article-card__meta-item">{{ item.author_name }}</span>{% endif %}
                    </div>
                  {% endif %}
                  <h2 class="h4 fw-bold lh-sm mb-3"><a class="stretched-link text-primary-emphasis text-decoration-none" href="{{ item.path }}">{{ item.title }}</a></h2>
                  {% if item.summary %}<p class="text-secondary mb-0">{{ item.summary }}</p>{% endif %}
                </div>
                {% if item.tags|default([]) %}
                  <footer class="card-footer bg-white border-0 pt-0 px-4 pb-4">
                    <div class="d-flex flex-wrap gap-2 position-relative z-1">
                      {% for tag in item.tags|slice(0, 4) %}<a class="badge rounded-pill text-bg-light text-primary-emphasis border text-decoration-none" href="{{ tag.url }}">#{{ tag.name }}</a>{% endfor %}
                    </div>
                  </footer>
                {% endif %}
              </article>
            </div>
          {% endfor %}
        </div>

        {% if filter.has_previous or filter.has_next %}
          <nav class="d-flex flex-wrap justify-content-end gap-2 mt-4" aria-label="Pagination">
            {% if filter.has_previous %}<a class="btn btn-outline-primary rounded-pill" href="{{ filter.previous_url }}">← {{ ui.previous_page }}</a>{% endif %}
            {% if filter.has_next %}<a class="btn btn-primary rounded-pill" href="{{ filter.next_url }}">{{ ui.next_page }} →</a>{% endif %}
          </nav>
        {% endif %}
      {% else %}
        <p class="empty-state card border-0 rounded-4 shadow-sm p-4">{{ ui.no_articles }}</p>
      {% endif %}
    </main>
  </div>

  {% if article_index_blocks_after|default([]) %}
    <div class="articles-index__blocks articles-index__blocks--after mt-4">
      {% include 'partials/content-blocks.twig' with { entry_blocks: article_index_blocks_after, is_preview: is_preview|default(false), visual_editing: visual_editing|default(false) } only %}
    </div>
  {% endif %}
</section>
