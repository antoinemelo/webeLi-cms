<!doctype html>
<html lang="{{ languageCode|default('fr') }}" class="theme-aurora"{% if is_preview|default(false) %} data-amcms-preview="1"{% endif %}{% if visual_editing|default(false) %} data-amcms-visual="1"{% endif %}{% if theme_preview|default(false) %} data-theme-preview="1"{% endif %}>
{% include 'partials/head.twig' %}
<body data-storefront-channel="web-main">
  <button type="button" class="storefront-cart-toggle" data-cart-toggle aria-controls="storefront-cart-drawer" aria-expanded="false" aria-label="Ouvrir le panier">Panier <span data-cart-count aria-live="polite">0</span></button>
  <a class="skip-link" href="#main-content">{{ ui.skip_to_content }}</a>

  {% include 'partials/site-header.twig' %}

  {% if theme_preview|default(false) %}
    <aside class="amcms-theme-preview-banner" role="status" aria-live="polite">
      Aperçu du template « {{ active_theme.name|default('Aurora Fullscreen') }} » — il n’est pas appliqué tant que vous ne l’enregistrez pas dans Configuration.
    </aside>
  {% endif %}

  {% if is_preview|default(false) %}
    <aside class="amcms-preview-banner" role="status" aria-live="polite">
      Aperçu de brouillon — cette page reflète la révision de travail courante et n’est pas la version publiée.
    </aside>
  {% endif %}

  <main id="main-content" class="main-content">
    {{ content|raw }}
  </main>

  {% include 'partials/site-footer.twig' %}
  {% include 'partials/cookie-consent.twig' %}
  <aside id="storefront-cart-drawer" class="storefront-cart-drawer" data-cart-drawer hidden aria-labelledby="storefront-cart-title"><button type="button" data-cart-close aria-label="Fermer le panier">Fermer</button><h2 id="storefront-cart-title">Votre panier</h2><div data-cart-error role="alert" aria-live="assertive"></div><div data-cart-lines></div><strong data-cart-total></strong><p><a data-cart-checkout href="{{ asset('/cart') }}">Voir le panier</a></p></aside>
  <link rel="stylesheet" href="{{ asset('/frontend/theme-default/assets/css/cart.css') }}"><script src="{{ asset('/frontend/theme-default/assets/js/storefront-cart.js') }}" defer></script>

  <script src="{{ asset('/frontend/theme-aurora/assets/js/app.js') }}" defer></script>
  <script src="{{ asset('/frontend/theme-aurora/assets/js/cookie-consent.js') }}" defer></script>
  {% if visual_editing|default(false) %}<script src="{{ asset('/frontend/theme-aurora/assets/js/visual-editing-bridge.js') }}" defer></script>{% endif %}
</body>
</html>
