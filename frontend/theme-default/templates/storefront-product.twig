{% set product=storefront_product %}<article class="storefront-product" data-product-id="{{ product.product_id }}"><header><p class="eyebrow">{{ product.type }}</p><h1>{{ product.name }}</h1><p>{{ product.summary }}</p></header>
{% include 'partials/storefront-block.twig' with {block_type:'product_detail',data:{product:product,show_price:true,show_availability:true}} only %}
{% if product.description %}<div class="prose-block">{{ product.description|markdown_to_html|raw }}</div>{% endif %}</article>
