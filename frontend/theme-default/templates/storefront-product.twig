{% set product=storefront_product %}{% set primary=product.sellables|first %}{% set en=product.locale|default('fr')|slice(0,2) == 'en' %}
<p><a class="btn btn--ghost" href="{{ storefront_return_url|default('/shop') }}">{{ en ? 'Back to catalog' : 'Retour au catalogue' }}</a></p>
<article class="storefront-product" data-product-detail data-product-id="{{ product.product_id }}">
  <div class="storefront-product__gallery" aria-label="{{ en ? 'Media for' : 'Médias de' }} {{ product.name }}">
    <div class="storefront-product__main-media" data-product-main-media>
      {% if product.media|default([]) %}{% set main=product.media|first %}{% if main.type == 'video' %}<video controls preload="metadata" src="{{ main.url }}" aria-label="{{ main.alt|default(product.name) }}"></video>{% else %}<img src="{{ main.url }}" alt="{{ main.alt|default(product.name) }}" width="1000" height="750">{% endif %}{% else %}<span class="storefront-media-missing" role="img" aria-label="{{ en ? 'Image unavailable' : 'Image indisponible' }}">{{ en ? 'Image unavailable' : 'Image indisponible' }}</span>{% endif %}<p data-product-media-caption>{{ main.caption|default('') }}</p>
    </div>
    {% if product.media|length > 1 %}<div class="storefront-product__thumbnails" role="list" aria-label="{{ en ? 'Choose media' : 'Choisir un média' }}">{% for medium in product.media %}<button type="button" role="listitem" data-product-media data-media-url="{{ medium.url }}" data-media-type="{{ medium.type|default('image') }}" data-media-alt="{{ medium.alt|default(product.name) }}" data-media-caption="{{ medium.caption|default('') }}" aria-label="{{ en ? 'Show' : 'Afficher' }} {{ medium.title|default(medium.alt|default(product.name)) }}">{% if medium.type == 'video' %}<span aria-hidden="true">▶</span>{% else %}<img src="{{ medium.url }}" alt="" width="96" height="72">{% endif %}</button>{% endfor %}</div>{% endif %}
  </div>
  <section class="storefront-product__summary" aria-labelledby="product-title">
    <p class="eyebrow">{{ product.type }}</p><h1 id="product-title">{{ product.name }}</h1>
    {% if product.projection.state|default('current') == 'delayed' %}<p class="storefront-projection-warning" role="status">{{ en ? 'Commercial information is being updated. Check price and availability in the cart.' : 'Les informations commerciales sont en cours d’actualisation. Vérifiez le prix et la disponibilité dans le panier.' }}</p>{% endif %}
    {% if product.summary %}<p>{{ product.summary }}</p>{% endif %}
    <p class="storefront-price" data-product-price>{% if product.price %}{% if product.price.regular_minor > product.price.final_minor %}<del>{{ (product.price.regular_minor / 100)|number_format(2, '.', ' ') }}</del> {% endif %}<strong>{{ (product.price.final_minor / 100)|number_format(2, '.', ' ') }} {{ product.price.currency }}</strong>{% endif %}</p>
    <p data-product-discount>{% if product.price.discount_percent_bps|default(0) > 0 %}{{ en ? 'Promotion' : 'Promotion' }} −{{ (product.price.discount_percent_bps / 100)|round }}%{% endif %}</p>
    <p class="storefront-availability storefront-availability--{{ product.availability.tone|default('neutral') }}" data-product-availability><span data-product-availability-icon aria-hidden="true">{% if product.availability.display_status == 'available' %}●{% elseif product.availability.display_status == 'last_available' %}◐{% elseif product.availability.display_status == 'on_order' %}◷{% else %}○{% endif %}</span> <span data-product-availability-label>{{ product.availability.label|default('Indisponible') }}</span></p>
    <p>SKU : <span data-product-sku>{{ product.sku|default(primary.sku|default('—')) }}</span></p><p data-product-delay>{% if product.availability.lead_time_days|default(0) > 0 %}{{ en ? 'Lead time' : 'Délai' }} : {{ product.availability.lead_time_days }} {{ en ? 'days' : 'jours' }}{% endif %}</p>
    {% if product.sellables|length > 1 %}<label for="product-variant-{{ product.product_id }}">{{ en ? 'Variant' : 'Variante' }}</label><select id="product-variant-{{ product.product_id }}" data-product-variant>{% for sellable in product.sellables %}<option value="{{ sellable.sellable_id }}" data-sku="{{ sellable.sku }}" data-regular="{{ sellable.price.regular_minor }}" data-final="{{ sellable.price.final_minor }}" data-currency="{{ sellable.price.currency }}" data-discount="{{ sellable.price.discount_percent_bps|default(0) }}" data-availability="{{ sellable.availability.label }}" data-status="{{ sellable.availability.display_status }}" data-tone="{{ sellable.availability.tone|default('neutral') }}" data-delay="{{ sellable.availability.lead_time_days|default(0) }}" data-orderable="{{ sellable.orderable ? '1' : '0' }}" data-media-url="{{ sellable.media[0].url|default('') }}" data-media-type="{{ sellable.media[0].type|default('image') }}" data-media-alt="{{ sellable.media[0].alt|default(product.name) }}" data-media-caption="{{ sellable.media[0].caption|default('') }}"{% if sellable.sellable_id == product.default_sellable_id %} selected{% endif %}>{{ sellable.name }} — {{ sellable.availability.label }}</option>{% endfor %}</select>{% endif %}
    <label for="product-quantity-{{ product.product_id }}">{{ en ? 'Quantity' : 'Quantité' }}</label><input id="product-quantity-{{ product.product_id }}" data-product-quantity type="number" min="1" step="1" value="1">
    <button type="button" class="btn btn--primary" data-product-add data-storefront-add-to-cart data-sellable-id="{{ product.default_sellable_id }}" data-quantity="1"{% if not product.cta %} disabled hidden{% endif %}>{{ en ? 'Add to cart' : 'Ajouter au panier' }}</button>
    <p class="visually-hidden" data-product-announcement role="status" aria-live="polite"></p>
  </section>
  {% if product.description %}<div class="prose-block storefront-product__description">{{ product.description|markdown_to_html|raw }}</div>{% endif %}
  {% if product.attributes|default([]) %}<section class="storefront-product__attributes" aria-labelledby="product-characteristics"><h2 id="product-characteristics">{{ en ? 'Characteristics' : 'Caractéristiques' }}</h2><dl>{% for attribute in product.attributes %}<div><dt>{{ attribute.name }}</dt><dd>{% for value in attribute.values %}{{ value.label }}{% if not loop.last %}, {% endif %}{% endfor %}{% if attribute.unit %} {{ attribute.unit }}{% endif %}</dd></div>{% endfor %}</dl></section>{% endif %}
  {% if product.sellables|length > 1 %}<section class="storefront-product__variants" aria-labelledby="other-variants"><h2 id="other-variants">{{ en ? 'Other variants' : 'Autres variantes' }}</h2><ul>{% for sellable in product.sellables %}<li><a href="{{ product.url }}?variant={{ sellable.sellable_id }}">{{ sellable.name }}</a> — {{ sellable.sku }} — {{ sellable.availability.label }}</li>{% endfor %}</ul></section>{% endif %}
  <section class="storefront-product__commerce" aria-labelledby="product-commerce"><h2 id="product-commerce">{{ en ? 'Delivery and payment' : 'Livraison et paiement' }}</h2>{% if product.commerce.delivery_methods|default([]) %}<h3>{{ en ? 'Delivery' : 'Livraison' }}</h3><ul>{% for method in product.commerce.delivery_methods %}<li>{{ method.label }}{% if method.price_minor > 0 %} — {{ (method.price_minor / 100)|number_format(2, '.', ' ') }}{% endif %}</li>{% endfor %}</ul>{% endif %}{% if product.commerce.payment_methods|default([]) %}<h3>{{ en ? 'Payment' : 'Paiement' }}</h3><ul>{% for method in product.commerce.payment_methods %}<li>{{ method.label }}{% if method.description %} — {{ method.description }}{% endif %}</li>{% endfor %}</ul>{% endif %}{% if not product.commerce.checkout_available %}<p>{{ en ? 'Online ordering is unavailable for this channel.' : 'Commande en ligne indisponible pour ce canal.' }}</p>{% endif %}</section>
  <section class="storefront-product__share" aria-labelledby="product-share"><h2 id="product-share">{{ en ? 'Share' : 'Partager' }}</h2><a href="mailto:?subject={{ product.name|url_encode }}&body={{ canonical|url_encode }}">E-mail</a> <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ canonical|url_encode }}" rel="noopener noreferrer">LinkedIn</a> <a href="https://www.facebook.com/sharer/sharer.php?u={{ canonical|url_encode }}" rel="noopener noreferrer">Facebook</a> <button type="button" data-copy-product-url data-url="{{ canonical }}">{{ en ? 'Copy link' : 'Copier le lien' }}</button><span data-copy-confirmation role="status" aria-live="polite"></span></section>
  {% if product.content|default([]) %}<section class="storefront-product__content" aria-labelledby="product-content"><h2 id="product-content">{{ en ? 'Learn more' : 'En savoir plus' }}</h2>{% for linked in product.content %}<article><h3><a href="{{ linked.url }}">{{ linked.title }}</a></h3>{% for block in linked.blocks %}{% include 'partials/content-block.twig' with {block:block,block_index:loop.index0,is_preview:false,visual_editing:false} only %}{% endfor %}</article>{% endfor %}</section>{% endif %}
  {% for relation in product.relations|default([]) %}<section class="storefront-product__relations" aria-labelledby="relation-{{ relation.type }}"><h2 id="relation-{{ relation.type }}">{{ relation.label }}</h2><div class="storefront-grid storefront-grid--products">{% for item in relation.items %}{% include 'partials/storefront-product-card.twig' with {item:item} only %}{% endfor %}</div></section>{% endfor %}
</article>
