{% set media=item.media|default([]) %}{% set price=item.price|default(null) %}{% set availability=item.availability|default(null) %}{% set en=item.locale|default('fr')|slice(0,2) == 'en' %}{% set display=display|default({price:true,promotion:true,availability:true,cta:true}) %}{% set view_label=display.view_label|default('')|trim %}{% set cart_label=display.cart_label|default('')|trim %}
<article class="storefront-card" data-product-id="{{ item.product_id }}">
  <a class="storefront-card__media" href="{{ item.url_with_return|default(item.url) }}" aria-label="{{ en ? 'View' : 'Voir' }} {{ item.name }}">
    {% if media %}<img src="{{ media[0].url }}" alt="{{ media[0].alt|default(item.name) }}" width="800" height="600" loading="lazy">
    {% else %}<span class="storefront-media-missing" role="img" aria-label="{{ en ? 'Image unavailable' : 'Image indisponible' }}">{{ en ? 'Image unavailable' : 'Image indisponible' }}</span>{% endif %}
  </a>
  <h2><a href="{{ item.url_with_return|default(item.url) }}">{{ item.name }}</a></h2>
  {% if item.card_summary|default(item.summary) %}<p>{{ item.card_summary|default(item.summary) }}</p>{% endif %}
  {% if price and display.price %}<p class="storefront-price">{% if display.promotion and price.regular_minor > price.final_minor %}<del>{{ (price.regular_minor / 100)|number_format(2, '.', ' ') }}</del> {% endif %}<strong>{{ (price.final_minor / 100)|number_format(2, '.', ' ') }} {{ price.currency }}</strong>{% if display.promotion and price.discount_percent_bps|default(0) > 0 %} <mark>−{{ (price.discount_percent_bps / 100)|round }}%</mark>{% endif %}</p>{% endif %}
  {% if availability and display.availability %}<p class="storefront-availability storefront-availability--{{ availability.tone|default('neutral') }}" data-availability="{{ availability.display_status|default(availability.status) }}"><span aria-hidden="true">{% if availability.display_status == 'available' %}●{% elseif availability.display_status == 'last_available' %}◐{% elseif availability.display_status == 'on_order' %}◷{% else %}○{% endif %}</span> {{ availability.label|default(availability.status) }}</p>{% endif %}
  {% if item.projection.state|default('current') == 'delayed' %}<p class="storefront-projection-warning" role="status">{{ en ? 'Information is being updated.' : 'Informations en cours d’actualisation.' }}</p>{% endif %}
  {% if display.cta %}<div class="storefront-card__actions">
    <a class="btn btn--ghost" href="{{ item.url_with_return|default(item.url) }}">{{ view_label ?: (en ? 'View' : 'Voir') }}</a>
    {% if item.cta|default(null) %}<button type="button" class="btn btn--primary" data-storefront-add-to-cart data-sellable-id="{{ item.cta.sellable_id }}" data-quantity="1">{{ cart_label ?: item.cta.label|default(en ? 'Add to cart' : 'Ajouter au panier') }}</button>{% endif %}
  </div>{% endif %}
  <details class="storefront-card__preview" data-product-preview>
    <summary>{{ en ? 'Enriched preview' : 'Aperçu enrichi' }}</summary>
    <div class="storefront-card__preview-body">
      <p><strong>{{ item.name }}</strong></p>
      {% if item.brand.name|default(null) %}<p>{{ item.brand.name }}</p>{% endif %}
      {% if item.summary|default(null) %}<p>{{ item.summary }}</p>{% endif %}
      {% if price and display.price %}<p>{% if display.promotion and price.regular_minor > price.final_minor %}<del>{{ (price.regular_minor / 100)|number_format(2, '.', ' ') }}</del> {% endif %}<strong>{{ (price.final_minor / 100)|number_format(2, '.', ' ') }} {{ price.currency }}</strong>{% if display.promotion and price.discount_percent_bps|default(0) > 0 %} · −{{ (price.discount_percent_bps / 100)|round }}%{% endif %}</p>{% endif %}
      {% for attribute in item.attributes|default([])|slice(0, 3) %}<p><strong>{{ attribute.name }} :</strong> {% for value in attribute.values|default([]) %}{{ value.label }}{% if not loop.last %}, {% endif %}{% endfor %}</p>{% endfor %}
      {% if availability and display.availability %}<p>{{ availability.label|default(availability.status) }}</p>{% endif %}
      <a href="{{ item.url_with_return|default(item.url) }}">{{ en ? 'View full details' : 'Consulter la fiche complète' }}</a>
    </div>
  </details>
</article>
