{% set header_languages = language_menu_items is defined ? language_menu_items : (languages|default([])) %}
{% if header_languages|length <= 1 %}
  {% set header_languages = [] %}
{% endif %}
{% set login_shortcut_enabled = show_login_shortcut|default(false) %}
{% if header_languages|default([]) or login_shortcut_enabled %}
<div class="header-actions header-actions--desktop d-none d-lg-flex align-items-center gap-2 ms-lg-3">
  {% if header_languages|default([]) %}
  <div class="dropdown language-switch language-switch--desktop">
    <button class="btn btn-outline-primary dropdown-toggle language-switch__button" type="button" data-bs-toggle="dropdown" aria-expanded="false">
      {{ ui.language_menu }}
    </button>
    <ul class="dropdown-menu dropdown-menu-end language-switch__menu">
{% for lang in header_languages %}
      <li>
        <a class="dropdown-item{% if lang.is_active %} active{% endif %}" href="{{ lang.url }}" hreflang="{{ lang.hreflang|default(lang.code) }}"{% if lang.is_active %} aria-current="true"{% endif %}>{{ lang.label }}</a>
      </li>
{% endfor %}
    </ul>
  </div>
  {% endif %}
  {% if login_shortcut_enabled %}
  <a class="login-shortcut login-shortcut--desktop" href="{{ admin_login_url|default(url('/admin/login')) }}" aria-label="Connexion" title="Connexion">
    <svg class="bi bi-person login-shortcut__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/></svg>
  </a>
  {% endif %}
</div>
{% endif %}
{% if header_languages|default([]) or login_shortcut_enabled %}
<div class="header-actions header-actions--mobile d-flex d-lg-none">
  {% if header_languages|default([]) %}
  <nav class="language-switch-mobile" aria-label="{{ ui.language_menu }}">
{% for lang in header_languages %}
    <a class="language-switch-mobile__link{% if lang.is_active %} active{% endif %}" href="{{ lang.url }}" hreflang="{{ lang.hreflang|default(lang.code) }}"{% if lang.is_active %} aria-current="true"{% endif %}>{{ lang.label }}</a>
{% endfor %}
  </nav>
  {% endif %}
  {% if login_shortcut_enabled %}
  <a class="login-shortcut login-shortcut--mobile" href="{{ admin_login_url|default(url('/admin/login')) }}" aria-label="Connexion" title="Connexion">
    <svg class="bi bi-person login-shortcut__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/></svg>
  </a>
  {% endif %}
</div>
{% endif %}
