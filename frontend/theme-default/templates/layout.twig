<!doctype html>
<html lang="{{ languageCode|default('fr') }}"{% if is_preview|default(false) %} data-amcms-preview="1"{% endif %}{% if visual_editing|default(false) %} data-amcms-visual="1"{% endif %}>
{% include 'partials/head.twig' %}
<body{% if storefront_cart_visible|default(false) %} data-storefront-channel="{{ storefront_channel_code }}" data-storefront-api-base="{{ public_api_url('sale/channels/' ~ storefront_channel_code) }}" data-storefront-cart-url="{{ localized_url('/cart', languageCode|default('fr')) }}" data-storefront-checkout-url="{{ localized_url('/checkout', languageCode|default('fr')) }}" data-app-base-path="{{ url('/') }}"{% endif %}>
  <a class="skip-link" href="#main-content">{{ ui.skip_to_content }}</a>

  {% include 'partials/site-header.twig' %}

  {% if is_preview|default(false) %}
    <aside class="amcms-preview-banner" role="status" aria-live="polite" style="position:sticky;top:0;z-index:1050;padding:.75rem 1rem;background:#fff3cd;border-bottom:1px solid #ffec99;color:#664d03;text-align:center;font-weight:600;">
      Aperçu de brouillon — cette page reflète la révision de travail courante et n’est pas la version publiée.
    </aside>
  {% endif %}

  <main id="main-content" class="container main-content">
    {% include 'partials/breadcrumbs.twig' %}
    {{ content|raw }}
  </main>

  {% include 'partials/site-footer.twig' %}
  {% include 'partials/cookie-consent.twig' %}
  {% if storefront_cart_visible|default(false) %}
    {% include 'partials/storefront-cart-drawer.twig' %}
    <link rel="stylesheet" href="{{ asset('/frontend/theme-default/assets/css/cart.css') }}"><link rel="stylesheet" href="{{ asset('/frontend/theme-default/assets/css/cart-header.css') }}"><script src="{{ asset('/frontend/theme-default/assets/js/storefront-cart.js') }}" defer></script>
  {% endif %}

  <script src="{{ asset('/frontend/theme-default/assets/js/storefront-product.js') }}" defer></script>
  <script src="{{ asset('/frontend/theme-default/assets/js/app.js') }}" defer></script>
  <script src="{{ asset('/frontend/theme-default/assets/js/cookie-consent.js') }}" defer></script>
  {% if visual_editing|default(false) %}<script src="{{ asset('/frontend/theme-default/assets/js/visual-editing-bridge.js') }}" defer></script>{% endif %}
</body>
</html>
