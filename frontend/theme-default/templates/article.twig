<article class="article-page" data-entry-key="{{ entry_key }}" itemscope itemtype="https://schema.org/Article">
  <header class="hero" aria-labelledby="article-title">
    {% if is_preview %}
      <span class="badge">{{ ui.preview }}</span>
    {% endif %}

    {% include 'components/article-meta.twig' with {
      display: article_display|default({}),
      type_label: entry_type_label,
      published_at: entry_published_at,
      published_at_label: entry_published_at_label|default(''),
      updated_at: entry_updated_at|default(''),
      updated_at_label: entry_updated_at_label|default(''),
      author_name: entry_author_name|default('')
    } %}

    <h1 id="article-title" itemprop="headline">{{ entry_title }}</h1>
  </header>

  <div class="prose article-page__body" itemprop="articleBody">
    {% include 'partials/content-blocks.twig' %}
  </div>
</article>
