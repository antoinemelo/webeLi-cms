---
import { AmCmsApiError } from '@amcms/client';
import { amcms } from '../lib/amcms';

type SectionResult = {
  ok: boolean;
  title: string;
  payload?: unknown;
  error?: {
    status?: number;
    code?: string;
    message: string;
    details?: unknown;
    requestId?: string;
  };
};

async function loadSection(title: string, loader: () => Promise<unknown>): Promise<SectionResult> {
  try {
    return { ok: true, title, payload: await loader() };
  } catch (error) {
    if (error instanceof AmCmsApiError) {
      return {
        ok: false,
        title,
        error: {
          status: error.status,
          code: error.code,
          message: error.message,
          details: error.details,
          requestId: error.requestId
        }
      };
    }

    return {
      ok: false,
      title,
      error: {
        message: error instanceof Error ? error.message : String(error)
      }
    };
  }
}

const sections = await Promise.all([
  loadSection('Route /', () => amcms.getRoute('/')),
  loadSection('Menu primary', () => amcms.getMenu('primary')),
  loadSection('Articles', () => amcms.getContent('article', { limit: 5 })),
  loadSection('Recherche test', () => amcms.search('test', { limit: 5 }))
]);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>DEC CMS Headless Astro</title>
    <style>
      body { font-family: system-ui, sans-serif; line-height: 1.5; margin: 2rem; max-width: 960px; }
      section { border: 1px solid #ddd; border-radius: 8px; margin: 1rem 0; padding: 1rem; }
      pre { background: #f6f6f6; overflow: auto; padding: 1rem; }
      .error { color: #9b1c1c; }
    </style>
  </head>
  <body>
    <h1>DEC CMS Headless Astro</h1>
    <p>Exemple minimal avec Astro et le SDK <code>@amcms/client</code>.</p>

    {sections.map((section) => (
      <section>
        <h2>{section.title}</h2>
        <pre class:list={{ error: !section.ok }}>{JSON.stringify(section.ok ? section.payload : section.error, null, 2)}</pre>
      </section>
    ))}
  </body>
</html>
